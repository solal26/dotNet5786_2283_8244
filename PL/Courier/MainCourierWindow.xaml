<Window x:Class="PL.Courier.MainCourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        mc:Ignorable="d"
        Title="MainCourierWindow" Height="500" Width="700"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Window.Resources>
        <local:ModeToVisibilityConverter x:Key="ModeToVisibilityOrderConverter"/>
    </Window.Resources>
    <Grid Height="487" VerticalAlignment="Top" >
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="478"/>

        </Grid.RowDefinitions>


        <Grid HorizontalAlignment="Left"  Margin="25,0,0,0" Width="452" Height="428" VerticalAlignment="Center" Grid.Row="1"  >
            <Grid.RowDefinitions>

                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="83"/>
                <ColumnDefinition Width="17"/>
                <ColumnDefinition Width="87*"/>
                <ColumnDefinition Width="89*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Id Number:" HorizontalAlignment="Left" FontSize="20" Width="113" Margin="0,0,0,4" Grid.Row="1" RenderTransformOrigin="0.628,-0.68" Grid.ColumnSpan="3" />
            <TextBox Text="{Binding CurrentCourier.Id}"  IsReadOnly="True"  HorizontalAlignment="Left" VerticalAlignment="Center"  FontSize="10" Height="15" Width="228" Grid.Column="2" Margin="55,0,0,0" Grid.Row="1" Grid.ColumnSpan="2"/>
            <Label Content="Phone Number:" HorizontalAlignment="Left" Grid.Row="2" FontSize="20"  VerticalAlignment="Center" Width="113" Height="34" Grid.ColumnSpan="3" />
            <TextBox Grid.Column="2"  Grid.Row="2"  Text="{Binding CurrentCourier.Phone}" VerticalAlignment="Center"  FontSize="10" Height="15" Margin="23,0,10,0" Grid.ColumnSpan="2"/>
            <Label Content="Email:" HorizontalAlignment="Left" Grid.Row="3" FontSize="20"  VerticalAlignment="Center" Width="64" Height="34" />
            <TextBox Grid.Column="2" Grid.Row="3" Text="{Binding CurrentCourier.Email}" VerticalAlignment="Center"  FontSize="10" Height="15" Margin="23,0,10,0" Grid.ColumnSpan="2"/>
            <Label Content="Password:" HorizontalAlignment="Left" Grid.Row="4" FontSize="20"  VerticalAlignment="Center" Width="96" Height="35" Grid.ColumnSpan="2" />
            <TextBox Grid.Column="2" Grid.Row="4" Text="{Binding CurrentCourier.Password}" VerticalAlignment="Center"  FontSize="10" Height="15" Margin="23,0,10,0" Grid.ColumnSpan="2"/>
            <Label Content="Is Active:" HorizontalAlignment="Left" Grid.Row="5" FontSize="20"  VerticalAlignment="Center" Width="96" Height="36" Grid.ColumnSpan="2" />
            <CheckBox Grid.Column="2" IsEnabled="False" HorizontalAlignment="Left" Grid.Row="5" IsChecked="{Binding CurrentCourier.Active}"  VerticalAlignment="Center"  FontSize="10" Height="15" Width="16" Grid.ColumnSpan="2" Margin="168,0,0,0"/>
            <Label Content="Max Delivery Distance:" HorizontalAlignment="Left" Grid.Row="6" FontSize="20"  VerticalAlignment="Center" Width="127" Height="36" Grid.ColumnSpan="3" />
            <TextBox Grid.Column="2" Grid.Row="6"  Text="{Binding CurrentCourier.MaxDeliveryDistance}" VerticalAlignment="Center"  FontSize="10" Height="15" Margin="55,0,10,0" Grid.ColumnSpan="2"/>
            <Label Content="Type of Delivery:" HorizontalAlignment="Left" Grid.Row="7" FontSize="20"  VerticalAlignment="Center" Width="160" Height="35" Grid.ColumnSpan="3" />
            <ComboBox HorizontalAlignment="Left" IsEnabled="{Binding haveCurrentOlder}" Grid.Row="7"  VerticalAlignment="Center"  FontSize="20" Height="35" 
                      ItemsSource="{Binding DeliveryTypes}"  SelectedItem="{Binding CurrentCourier.DeliveryType, Mode=TwoWay}" Width="148" Grid.Column="2" Grid.ColumnSpan="2" Margin="102,0,0,0"/>
            <Label Content="Start Date:" HorizontalAlignment="Left" Grid.Row="8" FontSize="20"  VerticalAlignment="Center" Width="113" Height="36" Grid.ColumnSpan="3" />
            <DatePicker HorizontalAlignment="Left" IsEnabled="False"  Grid.Row="8" VerticalAlignment="Top"   SelectedDate="{Binding CurrentCourier.StartDate}"  FontSize="10" Height="29" Width="128" Grid.Column="2" Grid.ColumnSpan="2" Margin="112,9,0,0"/>
            <Label Content="Delivered On Time:"  HorizontalAlignment="Left" Grid.Row="8" FontSize="20"  VerticalAlignment="Top" Width="212" Height="34" Grid.ColumnSpan="3" Margin="0,39,0,0" Grid.RowSpan="2" />
            <TextBox Grid.Column="2" Grid.Row="9" IsReadOnly="True" VerticalAlignment="Center" Text="{Binding CurrentCourier.DeliveredOnTime}"  FontSize="10" Height="15" Margin="102,0,0,0" Grid.ColumnSpan="2"/>
            <Label Content="Delivered Late:"  HorizontalAlignment="Left" Grid.Row="10" FontSize="20"  VerticalAlignment="Center" Width="160" Height="34" Grid.ColumnSpan="3" />
            <TextBox Grid.Column="2" Grid.Row="10" IsReadOnly="True" VerticalAlignment="Center" Text="{Binding CurrentCourier.DeliveredLate}"  FontSize="10" Height="15" Margin="55,0,0,0" Grid.ColumnSpan="2"/>
            <Button Content="{Binding ButtonText}" Click="btnChooseOrEnd_Click" Grid.Column="3" Margin="235,0,-178,0" RenderTransformOrigin="0.509,0.543" Height="45" VerticalAlignment="Center" />


        </Grid>
        <TextBox Text="{Binding CurrentCourier.FullName}" IsReadOnly="True" HorizontalAlignment="Left" Margin="180,10,0,0" Grid.Row="1" FontSize="30"  TextWrapping="Wrap" VerticalAlignment="Top" Width="291" Height="44"/>
        <Label Content="WELCOME" HorizontalAlignment="Left" FontSize="30" Margin="25,6,0,0" Grid.Row="1" VerticalAlignment="Top" Width="155" Height="48"/>
        <Button  Content="Update" Click="btnUpdate_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Width="120" Margin="535,396,0,0" Grid.Row="1" Height="42" RenderTransformOrigin="0.48,0.412"/>
        <Button Content="DeliveryHistory" Click="btnDeliveryHistory_Click" HorizontalAlignment="Left" Margin="535,304,0,0" Grid.Row="1" VerticalAlignment="Top" Width="120" Height="42"/>
        <Button Content="My current order" Visibility="{Binding haveCurrentOlder, Converter={StaticResource ModeToVisibilityOrderConverter}}" Click="btnCurrenrOrder_Click" HorizontalAlignment="Left" Margin="535,118,0,0" Grid.Row="1" VerticalAlignment="Top" Width="120" Height="42"/>









    </Grid>
</Window>
