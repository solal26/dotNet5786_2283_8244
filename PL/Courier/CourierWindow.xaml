<Window x:Class="PL.Courier.CourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        mc:Ignorable="d"
        Title="CourierWindow" Height="616" Width="441"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <local:ModeToReadOnlyConverter x:Key="ModeToReadOnlyConverter"/>
        <local:ModeToVisibilityConverter x:Key="ModeToVisibilityConverter"/>
        <local:NullCurrentOrderToVisibilityConverter x:Key="NullCurrentOrderToVisibilityConverter"/>
      
    </Window.Resources>

    <Grid Height="487" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="425"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" HorizontalAlignment="Left" Margin="90,0,0,0" Width="271">
            <Grid.RowDefinitions>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140*"/>
                <ColumnDefinition Width="168*"/>
            </Grid.ColumnDefinitions>

            <Label Content="Id Number:" Grid.Row="0" FontSize="10" VerticalAlignment="Center"/>
            <TextBox Text="{Binding CurrentCourier.Id}"
                     IsReadOnly="{Binding _isAddMode, Converter={StaticResource ModeToReadOnlyConverter}}"
                     Grid.ColumnSpan="2"
                     Margin="123,0,0,0"
                     FontSize="10" Height="15"/>

            <Label Content="Full name:" Grid.Row="1" FontSize="10" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding CurrentCourier.FullName}" FontSize="10" Height="15"/>

            <Label Content="Phone Number:" Grid.Row="2" FontSize="10" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding CurrentCourier.Phone}" FontSize="10" Height="15"/>

            <Label Content="Email:" Grid.Row="3" FontSize="10" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding CurrentCourier.Email}" FontSize="10" Height="15"/>

            <Label Content="Password:" Grid.Row="4" FontSize="10" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Grid.Row="4" Text="{Binding CurrentCourier.Password}" FontSize="10" Height="15"/>

            <Label Content="Is Active:" Grid.Row="5" FontSize="10" VerticalAlignment="Center"/>
            <CheckBox Grid.Column="1" Grid.Row="5" IsChecked="{Binding CurrentCourier.Active}"/>

            <Label Content="Max Delivery Distance:" Grid.Row="6" FontSize="10" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Grid.Row="6" Text="{Binding CurrentCourier.MaxDeliveryDistance}" FontSize="10" Height="15"/>

            <Label Content="Type of Delivery:" Grid.Row="7" FontSize="10" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" Grid.Row="7"
                      ItemsSource="{Binding DeliveryTypes}"
                      SelectedItem="{Binding CurrentCourier.DeliveryType, Mode=TwoWay}"
                      FontSize="10" Height="23"/>

            <Label Content="Start Date:" Grid.Row="8" FontSize="10" VerticalAlignment="Center"/>
            <DatePicker Grid.Column="1" Grid.Row="8"
                        SelectedDate="{Binding CurrentCourier.StartDate}"
                        IsEnabled="False"
                        FontSize="10" Height="23"/>

            <Label Content="Delivered On Time:"
                   Grid.Row="9" FontSize="10"
                   Visibility="{Binding _isAddMode, Converter={StaticResource ModeToVisibilityConverter}}"/>

            <TextBox Grid.Column="1" Grid.Row="9"
                     Text="{Binding CurrentCourier.DeliveredOnTime}"
                     FontSize="10" Height="15"
                     Visibility="{Binding _isAddMode, Converter={StaticResource ModeToVisibilityConverter}}"/>

            <Label Content="Delivered Late:"
                   Grid.Row="10" FontSize="10"
                   Visibility="{Binding _isAddMode, Converter={StaticResource ModeToVisibilityConverter}}"/>

            <TextBox Grid.Column="1" Grid.Row="10"
                     Text="{Binding CurrentCourier.DeliveredLate}"
                     FontSize="10" Height="15"
                     Visibility="{Binding _isAddMode, Converter={StaticResource ModeToVisibilityConverter}}"/>

            <!-- Bottom buttons -->
            <Button Content="{Binding ButtonText}"
                    Click="btnAddUpdate_Click"
                    Grid.Row="11"
                    Width="75"
                    Height="26"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,-40"/>

            <!-- DELETE button added next to ADD -->
            <Button Content="Delete"
                    Click="btnDeleteCourier_Click"
                    Grid.Row="11"
                    Width="75"
                    Height="26"
                    HorizontalAlignment="Left"
                    Margin="85,0,0,-40"
                    Visibility="{Binding _isAddMode, Converter={StaticResource NullCurrentOrderToVisibilityConverter}}"/>

        </Grid>
    </Grid>
</Window>
