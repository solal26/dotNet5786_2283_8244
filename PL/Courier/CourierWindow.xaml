<Window x:Class="PL.Courier.CourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        mc:Ignorable="d"
        Title="Courier"
        Height="620"
        Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <!-- ========= Resources ========= -->
    <Window.Resources>

        <local:ModeToReadOnlyConverter x:Key="ModeToReadOnlyConverter"/>
        <local:ModeToVisibilityConverter x:Key="ModeToVisibilityConverter"/>
        <local:NullCurrentOrderToVisibilityConverter x:Key="NullCurrentOrderToVisibilityConverter"/>

        <!-- TextBox style -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox / DatePicker -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Primary (Add / Update) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger (Delete) -->
        <Style x:Key="DangerButton" TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC2626"/>
        </Style>

    </Window.Resources>

    <!-- ========= Layout ========= -->
    <Grid>
        <Border Width="460"
                Padding="28"
                Background="White"
                CornerRadius="14"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="4"
                                  Opacity="0.2"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0"
                           Text="Courier Details"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Form -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="ID Number" Grid.Row="0"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding CurrentCourier.Id}"
                             IsReadOnly="{Binding _isAddMode, Converter={StaticResource ModeToReadOnlyConverter}}"/>

                    <TextBlock Text="Full Name" Grid.Row="1"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding CurrentCourier.FullName}"/>

                    <TextBlock Text="Phone Number" Grid.Row="2"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding CurrentCourier.Phone}"/>

                    <TextBlock Text="Email" Grid.Row="3"/>
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Text="{Binding CurrentCourier.Email}"/>

                    <TextBlock Text="Password" Grid.Row="4"/>
                    <TextBox Grid.Row="4" Grid.Column="1"
                             Text="{Binding CurrentCourier.Password}"/>

                    <TextBlock Text="Active" Grid.Row="5"/>
                    <CheckBox Grid.Row="5" Grid.Column="1"
                              VerticalAlignment="Center"
                              IsChecked="{Binding CurrentCourier.Active}"/>

                    <TextBlock Text="Max Delivery Distance" Grid.Row="6"/>
                    <TextBox Grid.Row="6" Grid.Column="1"
                             Text="{Binding CurrentCourier.MaxDeliveryDistance}"/>

                    <TextBlock Text="Type of Delivery" Grid.Row="7"/>
                    <ComboBox Grid.Row="7" Grid.Column="1"
                              ItemsSource="{Binding DeliveryTypes}"
                              SelectedItem="{Binding CurrentCourier.DeliveryType}"/>

                    <TextBlock Text="Start Date" Grid.Row="8"/>
                    <DatePicker Grid.Row="8" Grid.Column="1"
                                SelectedDate="{Binding CurrentCourier.StartDate}"
                                IsEnabled="False"/>

                    <TextBlock Text="Delivered On Time"
                               Grid.Row="9"
                               Visibility="{Binding _isAddMode, Converter={StaticResource ModeToVisibilityConverter}}"/>
                    <TextBox Grid.Row="9" Grid.Column="1"
                             Text="{Binding CurrentCourier.DeliveredOnTime}"
                             Visibility="{Binding _isAddMode, Converter={StaticResource ModeToVisibilityConverter}}"/>

                    <TextBlock Text="Delivered Late"
                               Grid.Row="10"
                               Visibility="{Binding _isAddMode, Converter={StaticResource ModeToVisibilityConverter}}"/>
                    <TextBox Grid.Row="10" Grid.Column="1"
                             Text="{Binding CurrentCourier.DeliveredLate}"
                             Visibility="{Binding _isAddMode, Converter={StaticResource ModeToVisibilityConverter}}"/>
                </Grid>

                <!-- Buttons -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">

                    <Button Content="{Binding ButtonText}"
                            Style="{StaticResource PrimaryButton}"
                            Click="btnAddUpdate_Click"/>

                    <Button Content="Delete"
                            Style="{StaticResource DangerButton}"
                            Margin="15,0,0,0"
                            Click="btnDeleteCourier_Click"
                            Visibility="{Binding CurrentCourier.CurrentOrder,
                            Converter={StaticResource NullCurrentOrderToVisibilityConverter}}"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
