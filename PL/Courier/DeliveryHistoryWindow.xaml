<Window x:Class="PL.Courier.DeliveryHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Delivery History"
        Height="500"
        Width="800"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Grid Background="#F5F6F8">
        <Border CornerRadius="12"
                Background="White"
                Padding="20"
                Margin="15"
                BorderBrush="#DDDDDD"
                BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="2"
                                  Opacity="0.25"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Text="Closed Deliveries"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"
                           Foreground="#2D2D2D"/>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding ClosedDeliveryList}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeRows="False"
                          CanUserResizeColumns="True"
                          EnableRowVirtualization="True"
                          RowHeight="36"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Background="White"
                          BorderThickness="1"
                          BorderBrush="#E0E0E0">

                    <!-- Column Header Style -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Background" Value="#F0F0F0"/>
                            <Setter Property="BorderBrush" Value="#DDDDDD"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <!-- Cell Style -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Delivery ID"
                                            Binding="{Binding DeliveryId}"
                                            Width="90"/>

                        <DataGridTextColumn Header="Order ID"
                                            Binding="{Binding OrderId}"
                                            Width="90"/>

                        <DataGridTextColumn Header="Order Type"
                                            Binding="{Binding OrderType}"
                                            Width="110"/>

                        <DataGridTextColumn Header="Address"
                                            Binding="{Binding FullAddress}"
                                            Width="2*"/>

                        <DataGridTextColumn Header="Delivery Type"
                                            Binding="{Binding DeliveryType}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Actual Distance"
                                            Binding="{Binding ActualDistance, StringFormat={}{0:0.##} km}"
                                            Width="130"/>

                        <DataGridTextColumn Header="Completion Time"
                                            Binding="{Binding CompletionTime}"
                                            Width="160"/>

                        <DataGridTextColumn Header="End Type"
                                            Binding="{Binding EndType}"
                                            Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
