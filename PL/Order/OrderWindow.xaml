<Window x:Class="PL.Order.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        mc:Ignorable="d"
        Title="Order"
        Height="600"
        Width="650"
        Background="#F3F4F6"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <!-- ================= RESOURCES ================= -->
    <Window.Resources>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Label -->
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Blue Button -->
        <Style x:Key="BlueButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Red Button -->
        <Style x:Key="RedButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <local:ModeToVisibilityConverter x:Key="ModeToVisibilityConverter"/>
        <local:OrderStatusToVisibilityConverter x:Key="OrderStatusToVisibilityConverter"/>

    </Window.Resources>

    <!-- ================= CONTENT ================= -->
    <Grid>
        <Border Width="560"
                Padding="25"
                Background="White"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ID -->
                <Label Content="Order ID"/>
                <TextBox Grid.Column="1"
                         Text="{Binding CurrentOrder.Id}"
                         IsReadOnly="True"/>

                <!-- Type -->
                <Label Grid.Row="1" Content="Type"/>
                <ComboBox Grid.Row="1" Grid.Column="1"
                          ItemsSource="{Binding OrderTypes}"
                          SelectedItem="{Binding CurrentOrder.Type}"/>

                <!-- Description -->
                <Label Grid.Row="2" Content="Description"/>
                <TextBox Grid.Row="2" Grid.Column="1"
                         Text="{Binding CurrentOrder.Description}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Height="60"/>

                <!-- Address -->
                <Label Grid.Row="3" Content="Full Address"/>
                <TextBox Grid.Row="3" Grid.Column="1"
                         Text="{Binding CurrentOrder.FullAddress}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Height="50"/>

                <!-- Air Distance -->
                <Label Grid.Row="4"
                       Content="Air Distance (km)"
                       Visibility="{Binding _isAddMode, Converter={StaticResource ModeToVisibilityConverter}}"/>
                <TextBox Grid.Row="4" Grid.Column="1"
                         Text="{Binding CurrentOrder.AirDistance}"
                         IsReadOnly="True"
                         Visibility="{Binding _isAddMode, Converter={StaticResource ModeToVisibilityConverter}}"/>

                <!-- Customer -->
                <Label Grid.Row="5" Content="Customer Name"/>
                <TextBox Grid.Row="5" Grid.Column="1"
                         Text="{Binding CurrentOrder.CustomerName}"/>

                <Label Grid.Row="6" Content="Customer Phone"/>
                <TextBox Grid.Row="6" Grid.Column="1"
                         Text="{Binding CurrentOrder.CustomerPhone}"/>

                <!-- Weight -->
                <Label Grid.Row="7" Content="Weight (kg)"/>
                <TextBox Grid.Row="7" Grid.Column="1"
                         Text="{Binding CurrentOrder.Weight}"/>

                <!-- Status -->
                <Label Grid.Row="8" Content="Order Status"/>
                <ComboBox Grid.Row="8" Grid.Column="1"
                          ItemsSource="{Binding OrderStatuses}"
                          SelectedItem="{Binding CurrentOrder.OrderStatus}"
                          IsEnabled="False"/>

                <Label Grid.Row="9" Content="Schedule Status"/>
                <ComboBox Grid.Row="9" Grid.Column="1"
                          ItemsSource="{Binding ScheduleStatuses}"
                          SelectedItem="{Binding CurrentOrder.ScheduleStatus}"
                          IsEnabled="False"/>

                <!-- Buttons -->
                <StackPanel Grid.Row="14"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">

                    <Button Content="{Binding ButtonText}"
                            Style="{StaticResource BlueButton}"
                            Click="btnAddUpdate_Click"/>

                    <Button Content="Cancel"
                            Style="{StaticResource RedButton}"
                            Margin="15,0,0,0"
                            Click="btnCancelOrder_Click"
                            Visibility="{Binding CurrentOrder.OrderStatus,
                                Converter={StaticResource OrderStatusToVisibilityConverter}}"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
