<Window x:Class="PL.Order.DeliveryPerOrderInListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Order"
        mc:Ignorable="d"
                Title="DeliveryHistoryWindow" Height="500" Width="800"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        >
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Last Deliveries"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"
                   Grid.Row="0"/>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding DeliveryPerOrderList}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  EnableRowVirtualization="True"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  CanUserResizeRows="False"
                  CanUserResizeColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding DeliveryId}" Header="Delivery ID" Width="Auto"/>
                <DataGridTextColumn Binding="{Binding CourierId}" Header="Courier ID" Width="Auto"/>
                <DataGridTextColumn Binding="{Binding CourierName}" Header="Courier Name" Width="Auto"/>
                <DataGridTextColumn Binding="{Binding StartTime}" Header="Start Time" Width="*"/>
                <DataGridTextColumn Binding="{Binding DeliveryType}" Header="Delivery Type" Width="Auto"/>
                <DataGridTextColumn Binding="{Binding EndTime}" Header="Completion Time" Width="Auto"/>
                <DataGridTextColumn Binding="{Binding EndType}" Header="Delivery End Type" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>