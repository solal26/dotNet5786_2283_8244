<Window x:Class="PL.Order.OpenOrderInListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Order"
        mc:Ignorable="d"
        Title="Open Orders" Height="640" Width="1140"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        Background="#F3F4F6">

    <Grid Margin="10">

        <!-- Title -->
        <TextBlock Text="Open Orders"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"
                   Grid.Row="0"/>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding OpenOrderList}"
                  AutoGenerateColumns="False"
                  EnableRowVirtualization="True"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  CanUserResizeColumns="True"
                  IsReadOnly="True"
                  Grid.RowSpan="2"
                  RowHeight="35"
                  FontSize="14"
                  Background="White"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Order ID" Binding="{Binding OrderId}" Width="80"/>
                <DataGridTextColumn Header="Order Type" Binding="{Binding Type}" Width="100"/>
                <DataGridTextColumn Header="Weight" Binding="{Binding Weight, StringFormat={}{0:0.##}}" Width="80"/>

                <!-- Address column wraps text -->
                <DataGridTextColumn Header="Address" Binding="{Binding FullAddress}" Width="250">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Distances with 2 decimal places -->
                <DataGridTextColumn Header="Air Distance (km)" Binding="{Binding AirDistance, StringFormat={}{0:0.##}}" Width="120"/>
                <DataGridTextColumn Header="Actual Distance (km)" Binding="{Binding ActualDistance, StringFormat={}{0:0.##}}" Width="130"/>

                <!-- TimeSpan: hh:mm:ss -->
                <DataGridTextColumn Header="Time Remaining" Binding="{Binding TimeRemaining}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding TimeRemaining, StringFormat={}{0:hh\\:mm\\:ss}}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Estimated Time" Binding="{Binding EstimatedActualTime}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding EstimatedActualTime, StringFormat={}{0:hh\\:mm\\:ss}}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- DateTime -->
                <DataGridTextColumn Header="Max Delivery Time" Binding="{Binding MaxDeliveryTime, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>

                <!-- Schedule Status with colors -->
                <DataGridTextColumn Header="Status" Binding="{Binding ScheduleStatus}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ScheduleStatus}" Value="Late">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ScheduleStatus}" Value="OnTime">
                                    <Setter Property="Foreground" Value="Green"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ScheduleStatus}" Value="InRisk">
                                    <Setter Property="Foreground" Value="Orange"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Collect button -->
                <!-- Collect button -->
                <DataGridTemplateColumn Header="Collect" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Collect"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="btnChooseOrder_Click"
                    Tag="{Binding OrderId}"
                    Width="80"
                    Height="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
