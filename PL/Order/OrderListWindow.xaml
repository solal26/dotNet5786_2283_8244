<Window x:Class="PL.Order.OrderListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        xmlns:BO="clr-namespace:BO;assembly=BL"
        mc:Ignorable="d"
        Title="Order Management"
        Height="640"
        Width="1000"
        Background="#F3F4F6"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <!-- ================= RESOURCES ================= -->
    <Window.Resources>

        <!-- ===== COLORS ===== -->
        <SolidColorBrush x:Key="BlueBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="RedBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#CBD5E1"/>

        <!-- ===== TEXTBOX / COMBOBOX ===== -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ===== PRIMARY BUTTON (ADD) ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== DANGER BUTTON (CANCEL) ===== -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource RedBrush}"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ===== CONVERTERS ===== -->
        <local:OrderStatusToVisibilityConverter x:Key="OrderStatusToVisibilityConverter"/>

        <ObjectDataProvider x:Key="OrderInListSortKey"
                            MethodName="GetValues"
                            ObjectType="{x:Type BO:OrderInListSort}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="BO:OrderInListSort"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- ===== COLLECTIONVIEWSOURCE לקיבוץ ===== -->
        <CollectionViewSource x:Key="GroupedOrders" Source="{Binding OrderList}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Type"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

    </Window.Resources>

    <!-- ================= MAIN LAYOUT ================= -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= FILTER CARD ================= -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,15">

            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="3"
                                  Opacity="0.15"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <!-- Filter Type -->
                <TextBlock Text="Filter by"
                           Grid.Row="0"
                           Grid.Column="0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="FilterTypeComboBox"
                          Grid.Row="0"
                          Grid.Column="1"
                          SelectionChanged="FilterType_SelectionChanged">
                    <ComboBoxItem Content="Order Status"/>
                    <ComboBoxItem Content="Schedule Status"/>
                </ComboBox>

                <!-- Filter Value -->
                <TextBlock Text="Value"
                           Grid.Row="1"
                           Grid.Column="0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="FilterValueComboBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          SelectionChanged="FilterValue_SelectionChanged"/>

                <!-- Sort -->
                <TextBlock Text="Sort by"
                           Grid.Row="1"
                           Grid.Column="3"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <ComboBox Grid.Row="1"
                          Grid.Column="4"
                          ItemsSource="{Binding Source={StaticResource OrderInListSortKey}}"
                          SelectedValue="{Binding Path=orderS, Mode=TwoWay}"
                          SelectionChanged="ChooseSort"/>
            </Grid>
        </Border>

        <!-- ================= ORDER LIST ================= -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="10">

            <DataGrid ItemsSource="{Binding Source={StaticResource GroupedOrders}}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      EnableRowVirtualization="True"
                      ColumnWidth="*"
                      SelectedItem="{Binding SelectedOrder}"
                      MouseDoubleClick="lsvOrderList_MouseDoubleClick">

                <!-- ====== GROUP HEADER ====== -->
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="Bold"
                                           Background="#E5E7EB"
                                           Padding="4"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding OrderId}" Header="ID"/>
                    <DataGridTextColumn Binding="{Binding OrderStatus}" Header="Status"/>
                    <DataGridTextColumn Binding="{Binding DeliveryId, TargetNullValue='—'}" Header="Delivery"/>
                    <DataGridTextColumn Binding="{Binding Type}" Header="Type"/>
                    <DataGridTextColumn Binding="{Binding ScheduleStatus}" Header="Schedule"/>
                    <DataGridTextColumn Binding="{Binding AirDistance, StringFormat='{}{0:F1} km'}" Header="Distance"/>
                    <DataGridTextColumn Binding="{Binding TimeRemaining, StringFormat='{}{0:hh\\:mm}'}" Header="Remaining"/>
                    <DataGridTextColumn Binding="{Binding TotalCompletionTime, StringFormat='{}{0:hh\\:mm}'}" Header="Handling"/>
                    <DataGridTextColumn Binding="{Binding TotalDeliveries}" Header="Shipments"/>

                    <DataGridTemplateColumn Header="Cancel">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Cancel"
                                        Style="{StaticResource DangerButton}"
                                        Visibility="{Binding OrderStatus,
                                            Converter={StaticResource OrderStatusToVisibilityConverter}}"
                                        Click="btnCancelOrder_Click"
                                        Tag="{Binding OrderId}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ================= ADD BUTTON ================= -->
        <Button Grid.Row="2"
                Content="Add New Order"
                Style="{StaticResource PrimaryButton}"
                Width="180"
                HorizontalAlignment="Center"
                Margin="0,15,0,0"
                Click="btnAddOrder_Click"/>

    </Grid>
</Window>
