<Window x:Class="PL.Order.OrderListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        xmlns:BO="clr-namespace:BO;assembly=BL"
        mc:Ignorable="d"
        Title="Order Management List"
        Height="640"
        Width="1000"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <!-- ================= RESOURCES ================= -->
    <Window.Resources>
        <local:OrderStatusToVisibilityConverter x:Key="OrderStatusToVisibilityConverter"/>
        <ObjectDataProvider x:Key="OrderInListSortKey"
                            MethodName="GetValues"
                            ObjectType="{x:Type BO:OrderInListSort}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="BO:OrderInListSort"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <!-- ================= LAYOUT ================= -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Filter + Sort -->
            <RowDefinition Height="*"/>
            <!-- Order List -->
            <RowDefinition Height="Auto"/>
            <!-- Bottom Button -->
        </Grid.RowDefinitions>

        <!-- ===== TOP BAR: FILTER TYPE + FILTER VALUE + SORT ===== -->
        <Grid Grid.Row="0" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Filter Type -->
                <RowDefinition Height="Auto"/>
                <!-- Filter Value -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <!-- Filter Type -->
            <Label Content="Filter by:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="16"/>
            <ComboBox x:Name="FilterTypeComboBox" Grid.Row="0" Grid.Column="1" Height="32"
                      SelectionChanged="FilterType_SelectionChanged">
                <ComboBoxItem Content="Order Status"/>
                <ComboBoxItem Content="Schedule Status"/>
            </ComboBox>

            <!-- Filter Value -->
            <Label Content="Value:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="16"/>
            <ComboBox x:Name="FilterValueComboBox" Grid.Row="1" Grid.Column="1" Height="32"
                      SelectionChanged="FilterValue_SelectionChanged"/>

            <!-- Sort -->
            <Label Content="Sort by:" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" FontSize="16"/>
            <ComboBox Grid.Row="1" Grid.Column="4"
                      ItemsSource="{Binding Source={StaticResource OrderInListSortKey}}"
                      SelectedValue="{Binding Path=orderS, Mode=TwoWay}"
                      SelectionChanged="ChooseSort"
                      Height="32"/>
        </Grid>

        <!-- ===== ORDER LIST ===== -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Path=OrderList}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  EnableRowVirtualization="True"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  SelectedItem="{Binding SelectedOrder}"
                  MouseDoubleClick="lsvOrderList_MouseDoubleClick"
                  ColumnWidth="*"
                  Margin="10">

            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding OrderId}" Header="Order ID"/>
                <DataGridTextColumn Binding="{Binding OrderStatus}" Header="Status"/>
                <DataGridTextColumn Binding="{Binding DeliveryId, TargetNullValue='None'}" Header="Delivery ID"/>
                <DataGridTextColumn Binding="{Binding Type}" Header="Order Type"/>
                <DataGridTextColumn Binding="{Binding ScheduleStatus}" Header="Schedule Status"/>
                <DataGridTextColumn Binding="{Binding AirDistance, StringFormat='{}{0:F1} km'}" Header="Distance"/>
                <DataGridTextColumn Binding="{Binding TimeRemaining, StringFormat='{}{0:hh\\:mm}'}" Header="Remaining Time"/>
                <DataGridTextColumn Binding="{Binding TotalCompletionTime, StringFormat='{}{0:hh\\:mm}'}" Header="Handling Time"/>
                <DataGridTextColumn Binding="{Binding TotalDeliveries}" Header="Total Shipments"/>

                <DataGridTemplateColumn Header="Cancel Order">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Cancel"
                                    Visibility="{Binding OrderStatus,
                                                 Converter={StaticResource OrderStatusToVisibilityConverter}}"
                                    Click="btnCancelOrder_Click"
                                    Tag="{Binding OrderId}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

        </DataGrid>

        <!-- ===== BOTTOM BUTTON ===== -->
        <Button Grid.Row="2"
                Content="Add New Order"
                Height="50"
                Width="150"
                Margin="10"
                HorizontalAlignment="Center"
                Click="btnAddOrder_Click"/>

    </Grid>
</Window>
