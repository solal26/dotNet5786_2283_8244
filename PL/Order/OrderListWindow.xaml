<Window x:Class="PL.Order.OrderListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Order"
        xmlns:BO="clr-namespace:BO;assembly=BL"
        mc:Ignorable="d"
        Title="Order Management List" Height="640" Width="1000" 
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <ObjectDataProvider x:Key="OrderStatusKey" 
                            MethodName="GetValues" 
                            ObjectType="{x:Type BO:OrderStatus}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="BO:OrderStatus"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="500*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Content="Filter by Order Status:"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"
                   VerticalAlignment="Top"/>

            <ComboBox ItemsSource="{Binding Source={StaticResource OrderStatusKey}}" 
                      Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" 
                      SelectedValue="{Binding Path=oStatus, Mode=TwoWay}" 
                      SelectionChanged="ChooseStatus"/>
        </Grid>

        <!-- 🔽 SEULE MODIFICATION ICI -->
        <DataGrid
                  ItemsSource="{Binding Path=OrderList}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  EnableRowVirtualization="True"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  SelectedItem="{Binding SelectedOrder}"
                  MouseDoubleClick="lsvOrderList_MouseDoubleClick"
                  ColumnWidth="*" RenderTransformOrigin="0.5,0.5" Margin="0,42,0,0" Grid.RowSpan="2">
            <DataGrid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="-0.132"/>
                    <RotateTransform/>
                    <TranslateTransform Y="-0.998"/>
                </TransformGroup>
            </DataGrid.RenderTransform>

            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding OrderId}" Header="Order ID"/>
                <DataGridTextColumn Binding="{Binding OrderStatus}" Header="Status"/>
                <DataGridTextColumn Binding="{Binding DeliveryId, TargetNullValue='None'}" Header="Delivery ID"/>
                <DataGridTextColumn Binding="{Binding DeliveryType}" Header="Order Type"/>
                <DataGridTextColumn Binding="{Binding ScheduleStatus}" Header="Schedule Status"/>
                <DataGridTextColumn Binding="{Binding Distance, StringFormat='{}{0:F1} km'}" Header="Distance"/>
                <DataGridTextColumn Binding="{Binding RemainingTime, StringFormat='{}{0:hh\\:mm}'}" Header="Remaining Time"/>
                <DataGridTextColumn Binding="{Binding TotalHandlingTime, StringFormat='{}{0:hh\\:mm}'}" Header="Handling Time"/>
                <DataGridTextColumn Binding="{Binding TotalDeliveries}" Header="Total Shipments"/>

                <DataGridTemplateColumn Header="Cancel Order">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Cancel"
                                    Click="btnCancelOrder_Click"
                                    Tag="{Binding OrderId}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="Add New Order"
                Grid.Row="2"
                HorizontalAlignment="Center"
                Height="50"
                Width="150"
                Click="btnAddOrder_Click"/>
    </Grid>
</Window>
