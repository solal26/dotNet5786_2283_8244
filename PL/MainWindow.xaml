<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Main Dashboard"
        Height="600"
        Width="700"
        Background="#F5F6F8"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="MainWindow_Loaded"
        Closed="MainWindow_Closed">

    <!-- ================= STYLES ================= -->
    <Window.Resources>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BlueColor" Color="#2C6BED"/>
        <SolidColorBrush x:Key="GreenColor" Color="#28A745"/>
        <SolidColorBrush x:Key="Accent" Color="#2C6BED"/>

        <!-- GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
        </Style>

        <!-- TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Clock Button -->
        <Style x:Key="ClockButton" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Background" Value="{StaticResource BlueColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Config Update Button -->
        <Style x:Key="ConfigUpdateButton" TargetType="Button">
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Background" Value="{StaticResource GreenColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>

        <!-- Summary Button -->
        <Style x:Key="SummaryButton" TargetType="Button">
            <Setter Property="Height" Value="22"/>

            <Setter Property="FontSize" Value="11"/>

            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="2,1"/>

            <Setter Property="Width" Value="100"/>

            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{StaticResource BlueColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>


        <!-- Action Button -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Background" Value="{StaticResource GreenColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

    </Window.Resources>

    <!-- ================= ROOT GRID ================= -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Clock -->
            <RowDefinition Height="*"/>
            <!-- Config + Summary -->
            <RowDefinition Height="Auto"/>
            <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- ================= CLOCK (CENTER) ================= -->
        <GroupBox Header="System Clock"
                  Grid.Row="0"
                  HorizontalAlignment="Center"
                  Padding="10">

            <StackPanel HorizontalAlignment="Center">

                <TextBlock Text="{Binding CurrentTime}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource Accent}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <!-- Clock Buttons -->
                <UniformGrid Columns="3" Margin="0,0,0,4">
                    <Button Content="+1 Min" Click="btnAddOneMinute_Click" Style="{StaticResource ClockButton}"/>
                    <Button Content="+1 Hr" Click="btnAddOneHour_Click" Style="{StaticResource ClockButton}"/>
                    <Button Content="+1 Day" Click="btnAddOneDay_Click" Style="{StaticResource ClockButton}"/>
                </UniformGrid>

                <UniformGrid Columns="2">
                    <Button Content="+1 Month" Click="btnAddOneMonth_Click" Style="{StaticResource ClockButton}"/>
                    <Button Content="+1 Year" Click="btnAddOneYear_Click" Style="{StaticResource ClockButton}"/>
                </UniformGrid>

            </StackPanel>
        </GroupBox>

        <!-- ================= CONFIG + SUMMARY ================= -->
        <Grid Grid.Row="1" Margin="0,6,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== CONFIGURATION (LEFT) ========== -->
            <GroupBox Header="Configuration" Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Company Address Label -->
                    <TextBlock Text="Company Address"
           Grid.Row="0"
           FontSize="16"
           FontWeight="Bold"
           Foreground="{StaticResource Accent}"/>

                    <!-- Company Address Input + Update -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Width="128"
             FontSize="14"
             FontWeight="SemiBold"
             Text="{Binding Configuration.CompanyAddress}" TextChanged="TextBox_TextChanged"/>
                        <Button Content="Update"
            Style="{StaticResource ConfigUpdateButton}"
            Click="UpdateCompanyAddress_Click" RenderTransformOrigin="0.5,0.5" Width="64">
                            <Button.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform AngleY="-0.821"/>
                                    <RotateTransform/>
                                    <TranslateTransform Y="0.43"/>
                                </TransformGroup>
                            </Button.RenderTransform>
                        </Button>
                    </StackPanel>

                    <!-- Max Range -->
                    <TextBlock Text="Max Range (km)" Grid.Row="1"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding Configuration.MaxRange}" Width="120"/>
                        <Button Content="Update" Style="{StaticResource ConfigUpdateButton}"
                                Click="UpdateMaxRange_Click"/>
                    </StackPanel>

                    <!-- Avg Speeds -->
                    <TextBlock Text="Avg Car Speed" Grid.Row="2"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding Configuration.AvgCarSpeed}" Width="120"/>
                        <Button Content="Update" Style="{StaticResource ConfigUpdateButton}"
                                Click="UpdateAvgCarSpeed_Click"/>
                    </StackPanel>

                    <TextBlock Text="Avg Motorbike Speed" Grid.Row="3"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding Configuration.AvgMotorBikeSpeed}" Width="120"/>
                        <Button Content="Update" Style="{StaticResource ConfigUpdateButton}"
                                Click="UpdateAvgMotorBikeSpeed_Click"/>
                    </StackPanel>

                    <TextBlock Text="Avg Bicycle Speed" Grid.Row="4"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding Configuration.AvgBicycleSpeed}" Width="120"/>
                        <Button Content="Update" Style="{StaticResource ConfigUpdateButton}"
                                Click="UpdateAvgBicycleSpeed_Click"/>
                    </StackPanel>

                    <TextBlock Text="Avg Walking Speed" Grid.Row="5"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding Configuration.AvgWalkingSpeed}" Width="120"/>
                        <Button Content="Update" Style="{StaticResource ConfigUpdateButton}"
                                Click="UpdateAvgWalkingSpeed_Click"/>
                    </StackPanel>

                    <TextBlock Text="Max Delivery Time" Grid.Row="6"/>
                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding Configuration.MaxDeliveryTime}" Width="120"/>
                        <Button Content="Update" Style="{StaticResource ConfigUpdateButton}"
                                Click="UpdateMaxDeliveryTime_Click"/>
                    </StackPanel>

                    <TextBlock Text="Risk Range" Grid.Row="7"/>
                    <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding Configuration.RiskRange}" Width="120"/>
                        <Button Content="Update" Style="{StaticResource ConfigUpdateButton}"
                                Click="UpdateRiskRange_Click"/>
                    </StackPanel>

                    <TextBlock Text="Inactivity Range" Grid.Row="8"/>
                    <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding Configuration.InactivityRange}" Width="120"/>
                        <Button Content="Update" Style="{StaticResource ConfigUpdateButton}"
                                Click="UpdateInactivityRange_Click"/>
                    </StackPanel>

                </Grid>
            </GroupBox>

            <!-- ========== ORDERS SUMMARY (RIGHT, ONE COLUMN) ========== -->
            <GroupBox Header="Orders Summary" Grid.Column="1">
                <ItemsControl ItemsSource="{Binding OrdersSummary}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding DisplayText}"
                        Tag="{Binding Tag}"
                        Style="{StaticResource SummaryButton}"
                        Click="SummaryButton_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>


        </Grid>

        <!-- ================= ACTION BUTTONS ================= -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,8">

            <Button Content="Order Management" Click="btnOrders_Click" Style="{StaticResource ActionButton}"/>
            <Button Content="Courier List" Click="btnCouriers_Click" Style="{StaticResource ActionButton}"/>
            <Button Content="Initialize DB" Click="btnInitialize_Click" Style="{StaticResource ActionButton}"/>
            <Button Content="Reset DB" Click="btnReset_Click" Style="{StaticResource ActionButton}"/>

        </StackPanel>

    </Grid>
</Window>
