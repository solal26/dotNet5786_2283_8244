<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="1000" 
   	 DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
         Loaded="MainWindow_Loaded" Closed="MainWindow_Closed"
        >
   
      


    <Grid>
        <!-- =================== Grid Rows & Columns =================== -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- System Clock Label -->
            <RowDefinition Height="Auto"/>
            <!-- System Clock Buttons -->
            <RowDefinition Height="Auto"/>
            <!-- Max Delivery Time -->
            <RowDefinition Height="Auto"/>
            <!-- Inactivity Timeout -->
            <RowDefinition Height="*"/>
            <!-- Spacer / General Buttons -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- Labels -->
            <ColumnDefinition Width="Auto"/>
            <!-- TextBoxes -->
            <ColumnDefinition Width="Auto"/>
            <!-- Update Buttons -->
        </Grid.ColumnDefinitions>

        <!-- ======================== System Clock ======================== -->
        <Label Grid.Row="0" Grid.Column="0" Content="System Clock:" VerticalAlignment="Center" Margin="5"/>
        
        <Label Grid.Row="0" Grid.Column="1" Content="{Binding CurrentTime}" FontWeight="Bold" FontSize="20"/>


        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Left" Margin="5">
            <Button Content="Add One min" Click="btnAddOneMinute_Click" Width="80" Height="30" Margin="2"/>
            <Button Content="Add One hr" Click="btnAddOneHour_Click" Width="80" Height="30" Margin="2"/>
            <Button Content="Add One day"  Click="btnAddOneDay_Click" Width="80" Height="30" Margin="2"/>
            <Button Content="Add One month" Click="btnAddOneMonth_Click" Width="90" Height="30" Margin="2"/>
            <Button Content="Add One year" Click="btnAddOneYear_Click"  Width="80" Height="30" Margin="2"/>
                      
        </StackPanel>

        <!-- ======================== Configuration Variables ======================== -->
        <!-- Max Delivery Time -->
        <Label Grid.Row="2" Grid.Column="0" Content="Max Delivery Time:" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="2" Grid.Column="1" Width="120" Margin="5" Text="{Binding Configuration.MaxDeliveryTime, UpdateSourceTrigger=PropertyChanged}"/>
        <Button Grid.Row="2" Grid.Column="2" Content="Update" Width="60" Height="25" Margin="5"/>

        <!-- Inactivity Timeout -->
        <Label Grid.Row="3" Grid.Column="0" Content="Inactivity Timeout:" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="3" Grid.Column="1" Width="120" Margin="5" Text="{Binding Configuration.InactivityRange, UpdateSourceTrigger=PropertyChanged}"/>
        <Button Grid.Row="3" Grid.Column="2" Content="Update" Width="60" Height="25" Margin="5"/>

        <!-- ======================== General Buttons + Orders Summary ======================== -->
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
            Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="10">

            <!-- הכפתורים הקיימים בצד שמאל -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Order Management" Click="btnOrders_Click" Width="130" Height="30" Margin="5,0"/>
                <Button Content="Open List Screen" Click="btnCouriers_Click" Width="100" Height="30" Margin="5,0"/>
                <Button Content="Initialize DB" Click="btnInitialize_Click" Width="100" Height="30" Margin="5,0"/>
                <Button Content="Reset DB" Click="btnReset_Click" Width="100" Height="30" Margin="5,0"/>
            </StackPanel>

            <!-- הסיכום בצד ימין -->
            <StackPanel Orientation="Vertical"
            HorizontalAlignment="Right"
            Margin="20,0,0,0">

                <TextBlock Text="Orders Summary"
               FontWeight="Bold"
               FontSize="16"
               Margin="0,0,0,5"
               HorizontalAlignment="Right"/>

                <ItemsControl ItemsSource="{Binding OrdersSummary}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding DisplayText}"
                        Tag="{Binding Tag}"
                        Margin="0,2"
                        Click="SummaryButton_Click"
                        HorizontalAlignment="Right"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>