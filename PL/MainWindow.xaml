<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PL.Courier"
        Title="Main Dashboard"
        Height="650"
        Width="750"
        Background="#F5F6F8"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="MainWindow_Loaded"
        Closed="MainWindow_Closed">

    <Window.Resources>
        <SolidColorBrush x:Key="BlueColor" Color="#2C6BED"/>
        <SolidColorBrush x:Key="GreenColor" Color="#28A745"/>
        <SolidColorBrush x:Key="Accent" Color="#2C6BED"/>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ClockButton" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Background" Value="{StaticResource BlueColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="ConfigUpdateButton" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="{StaticResource GreenColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>

        <Style x:Key="SummaryButton" TargetType="Button">
            <Setter Property="Height" Value="25"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Background" Value="{StaticResource BlueColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Background" Value="{StaticResource BlueColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <local:ModeEnableSimulatorConverter x:Key="ModeEnableSimulatorConverter"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="System Clock" Grid.Row="0" HorizontalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding CurrentTime}"
                           FontSize="32" FontWeight="Bold" Foreground="{StaticResource Accent}"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <UniformGrid Columns="3">
                    <Button Content="+1 Min" Click="btnAddOneMinute_Click" Style="{StaticResource ClockButton}"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource ModeEnableSimulatorConverter}}"/>
                    <Button Content="+1 Hr" Click="btnAddOneHour_Click" Style="{StaticResource ClockButton}"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource ModeEnableSimulatorConverter}}"/>
                    <Button Content="+1 Day" Click="btnAddOneDay_Click" Style="{StaticResource ClockButton}"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource ModeEnableSimulatorConverter}}"/>
                    <Button Content="+1 Month" Click="btnAddOneMonth_Click" Style="{StaticResource ClockButton}"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource ModeEnableSimulatorConverter}}"/>
                    <Button Content="+1 Year" Click="btnAddOneYear_Click" Style="{StaticResource ClockButton}"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource ModeEnableSimulatorConverter}}"/>
                </UniformGrid>
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Configuration" Grid.Column="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Company Address" Grid.Row="0" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,5"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                            <TextBox Width="150" Text="{Binding Configuration.CompanyAddress}" VerticalContentAlignment="Center"/>
                            <Button Content="Update" Click="UpdateCompanyAddress_Click" Style="{StaticResource ConfigUpdateButton}"
                                    IsEnabled="{Binding IsRunning, Converter={StaticResource ModeEnableSimulatorConverter}}"/>
                        </StackPanel>

                        <TextBlock Text="Max Range (km)" Grid.Row="1"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                            <TextBox Text="{Binding Configuration.MaxRange}" Width="60"/>
                            <Button Content="Update" Click="UpdateMaxRange_Click" Style="{StaticResource ConfigUpdateButton}"
                                    IsEnabled="{Binding IsRunning, Converter={StaticResource ModeEnableSimulatorConverter}}"/>
                        </StackPanel>

                        <TextBlock Text="Avg Car Speed" Grid.Row="2"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                            <TextBox Text="{Binding Configuration.AvgCarSpeed}" Width="60"/>
                            <Button Content="Update" Click="UpdateAvgCarSpeed_Click" Style="{StaticResource ConfigUpdateButton}"
                                    IsEnabled="{Binding IsRunning, Converter={StaticResource ModeEnableSimulatorConverter}}"/>
                        </StackPanel>

                        <TextBlock Text="Avg Motorbike Speed" Grid.Row="3"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                            <TextBox Text="{Binding Configuration.AvgMotorBikeSpeed}" Width="60"/>
                            <Button Content="Update" Click="UpdateAvgMotorBikeSpeed_Click" Style="{StaticResource ConfigUpdateButton}"
                                    IsEnabled="{Binding IsRunning, Converter={StaticResource ModeEnableSimulatorConverter}}"/>
                        </StackPanel>

                        <TextBlock Text="Max Delivery Time" Grid.Row="4"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                            <TextBox Text="{Binding Configuration.MaxDeliveryTime}" Width="60"/>
                            <Button Content="Update" Click="UpdateMaxDeliveryTime_Click" Style="{StaticResource ConfigUpdateButton}"
                                    IsEnabled="{Binding IsRunning, Converter={StaticResource ModeEnableSimulatorConverter}}"/>
                        </StackPanel>

                        <TextBlock Text="Risk Range" Grid.Row="5"/>
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                            <TextBox Text="{Binding Configuration.RiskRange}" Width="60"/>
                            <Button Content="Update" Click="UpdateRiskRange_Click" Style="{StaticResource ConfigUpdateButton}"
                                    IsEnabled="{Binding IsRunning, Converter={StaticResource ModeEnableSimulatorConverter}}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </GroupBox>

            <GroupBox Header="Orders Summary" Grid.Column="1">
                <ItemsControl ItemsSource="{Binding OrdersSummary}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding DisplayText}" Tag="{Binding Tag}" Click="SummaryButton_Click"
                                    Style="{StaticResource SummaryButton}"
                                    IsEnabled="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ModeEnableSimulatorConverter}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Order Management" Click="btnOrders_Click" Style="{StaticResource ActionButton}"/>
                <Button Content="Courier List" Click="btnCouriers_Click" Style="{StaticResource ActionButton}"/>

                <Button Content="Initialize DB" Click="btnInitialize_Click" Style="{StaticResource ActionButton}" Background="{StaticResource GreenColor}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource ModeEnableSimulatorConverter}}"/>
                <Button Content="Reset DB" Click="btnReset_Click" Style="{StaticResource ActionButton}" Background="#DC3545"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource ModeEnableSimulatorConverter}}"/>
            </StackPanel>

            <Separator Margin="0,10" Background="#D0D0D0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Label Content="Simulation Speed (Interval):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" 
                         Width="70" Height="30" VerticalContentAlignment="Center" FontSize="14" Margin="0,0,20,0"
                         IsEnabled="{Binding IsRunning, Converter={StaticResource ModeEnableSimulatorConverter}}"/>

                <Button Content="{Binding buttonText}" Click="BtnRun_Click" 
                        Width="140" Height="40" FontSize="14" FontWeight="Bold"
                        Background="{StaticResource GreenColor}" Foreground="White">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>