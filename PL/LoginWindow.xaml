<Window x:Class="PL.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800">
    <Grid RenderTransformOrigin="0.574,0.414">

        <Label Content="Enter your ID:" HorizontalAlignment="Left" Margin="188,158,0,0" VerticalAlignment="Top" FontSize="24" Height="47"/>
        <TextBox TextWrapping="Wrap" Text="{Binding Username,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}" RenderTransformOrigin="0.494,0.613" Margin="368,161,252,233" >
            <TextBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0"/>
                    <TranslateTransform X="0.022" Y="0.003"/>
                </TransformGroup>
            </TextBox.RenderTransform>
        </TextBox>
        <Button Content="Login" HorizontalAlignment="Left" Margin="474,217,0,0" VerticalAlignment="Top" Width="75" Click="btnLogin_Click"/>

    </Grid>
</Window>
